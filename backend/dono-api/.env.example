APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Local Termux only: set false to test login without email verification.
# Keep true in Render and every production environment.
EMAIL_VERIFICATION_REQUIRED=true
# Public frontend URL used after verification and password-reset flows.
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Render Postgres can be supplied as DB_URL with DB_CONNECTION=pgsql.
DB_URL=

DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Use public for local/Termux testing. Set to s3 with AWS_* values for persistent hosted media.
FILESYSTEM_DISK=public
# Assignment/submission files use a private disk and signed authenticated links.
# Keep local for Termux; set s3 in production with the AWS_* values configured.
ASSIGNMENT_PRIVATE_DISK_DRIVER=local
# Optional absolute scanner command (for example clamdscan) for upload validation.
UPLOAD_SCANNER=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OAuth / Passport. Set false to disable machine integrations while keeping Sanctum login active.
# Generate keys during deployment with `php artisan passport:keys` or supply PEM values through secret variables.
# Never commit private keys. Keep this true only after Composer dependencies and keys are ready.
OAUTH_ENABLED=true
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
OAUTH_CLIENT_TOKEN_MINUTES=60

# Encrypted database backup. The scheduled job is disabled unless explicitly enabled.
BACKUP_SCHEDULE_ENABLED=false
BACKUP_RETENTION_ENABLED=false
BACKUP_RETENTION_DAYS=30
BACKUP_DISK=local
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_PG_DUMP_BINARY=pg_dump
BACKUP_GPG_BINARY=gpg

# Twilio SMS provider and verified status callback URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_URL=

# Firebase Cloud Messaging HTTP v1 service account. Keep JSON/path server-side only.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Paystack merchant configuration
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN

# Server-side AI tutor. Keep the API key private and enable only after a provider is configured.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_MAX_COMPLETION_TOKENS=1200

# Live-room provider. Keep disabled until room admission, moderation, recording, and callbacks are configured and tested.
LIVE_ROOMS_ENABLED=false
LIVE_ROOMS_PROVIDER=
LIVE_ROOMS_PROVIDER_BASE_URL=
LIVE_ROOMS_PROVIDER_PUBLIC_URL=
LIVE_ROOMS_PROVIDER_API_KEY=
LIVE_ROOMS_PROVIDER_API_SECRET=
LIVE_ROOMS_PROVIDER_WEBHOOK_SECRET=
LIVE_ROOMS_RECORDING_ENABLED=false
LIVE_ROOMS_ADAPTER_READY=false

# Live-room provider recording output (disabled unless all provider gates are enabled)
LIVE_ROOMS_RECORDING_S3_BUCKET=
LIVE_ROOMS_RECORDING_S3_REGION=us-east-1
LIVE_ROOMS_RECORDING_S3_ENDPOINT=
LIVE_ROOMS_RECORDING_S3_ACCESS_KEY=
LIVE_ROOMS_RECORDING_S3_SECRET=
LIVE_ROOMS_RECORDING_RETENTION_DAYS=30
